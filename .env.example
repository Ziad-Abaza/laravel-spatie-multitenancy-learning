APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LANDLORD_DOMAIN=localhost
TENANT_DOMAIN_SUFFIX=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Passwords for seeded admin/owner accounts. Both default to "password" only
# when APP_ENV=local; the corresponding seeding is skipped in other envs.
# SEED_TENANT_OWNER_PASSWORD=
# SEED_LANDLORD_ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The application default connection is the landlord database. Host/credentials
# are shared by the landlord and tenant connections; each may be switched to a
# file-based driver via DB_*_DRIVER=sqlite (DB_*_DATABASE then holds a file path).
DB_CONNECTION=landlord
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_LANDLORD_DRIVER=mysql
# DB_LANDLORD_DATABASE=database/landlord.sqlite
DB_TENANT_DRIVER=mysql
# DB_TENANT_DATABASE=database/tenant.sqlite

SESSION_DRIVER=database
# Session rows are landlord-owned; blank resolves to the default (landlord) connection.
# SESSION_CONNECTION=landlord
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Jobs, batches, and failed_jobs are landlord-owned; blank resolves to landlord.
# DB_QUEUE_CONNECTION=landlord

CACHE_STORE=database
# Cache rows are landlord-owned; blank resolves to the default (landlord) connection.
# DB_CACHE_CONNECTION=landlord
# CACHE_PREFIX=

# Media library storage (tenant files land on each tenant's media table).
MEDIA_DISK=public
# MEDIA_CONVERSIONS_DISK=
# MEDIA_QUEUE=
# MEDIA_DOWNLOADER_SSL=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
